# Firebase Admin SDK credentials (from your service account JSON)
PROJECT_ID=your-firebase-project-id
CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
STORAGE_BUCKET=your-project.appspot.com

# CORS — comma-separated list of allowed origins (e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Chatbot access default — "false" = denied (thesis pilot); flip to "true" + redeploy at public launch, no migration
CHATBOT_DEFAULT_ACCESS=false

# Default OFF = current legacy behavior. Set to "true" only after a passing pre-session smoke test.
# Flip requires: edit this file + firebase deploy --only functions. No frontend rebuild needed.
FEATURE_ASSESSMENT=false
FEATURE_PREMIUM_ENROLLMENT=false